{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "cloud-map-generator",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "rust/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-golden')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-core')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-gpu')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-service')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-cli')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-mcp')].version"
        },
        {
          "type": "toml",
          "path": "rust/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='cloud-map-generator-wasm')].version"
        }
      ]
    }
  }
}
